# ============================================
# VitaBrevis - Variables de Entorno
# ============================================
# IMPORTANTE: Copia este archivo a .env y modifica los valores

# ============================================
# GENERAL
# ============================================
ENVIRONMENT=development  # development | staging | production
APP_NAME=VitaBrevis

# ============================================
# DATABASE
# ============================================
DB_USER=vitabrevis
DB_PASSWORD=change_this_secure_password_in_production
DB_NAME=vitabrevis_db
DB_HOST=localhost  # 'db' si usas Docker
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# SEGURIDAD - BACKEND
# ============================================
# Generar con: openssl rand -hex 32
SECRET_KEY=your_secret_key_change_this_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clave de cifrado AES-256 (debe ser exactamente 32 bytes en base64)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_32_bytes_minimum_change_this

# ============================================
# CORS (Frontend URLs permitidas)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=VitaBrevis
VITE_ENABLE_2FA=true

# ============================================
# EMAIL (para notificaciones y 2FA)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vitabrevis.com
SMTP_FROM_NAME=VitaBrevis

# ============================================
# ALMACENAMIENTO DE ARCHIVOS
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50  # Tamaño máximo de archivos en MB

# ============================================
# GDPR / LOGGING / AUDITORÍA
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
AUDIT_LOG_RETENTION_DAYS=2555  # 7 años (requisito legal)
ENABLE_AUDIT_LOG=true

# ============================================
# RATE LIMITING (protección anti-abuso)
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Cron: cada día a las 2 AM
BACKUP_RETENTION_DAYS=90

# ============================================
# CLÍNICA (Personalización)
# ============================================
CLINIC_NAME=Mi Clínica de Longevidad
CLINIC_ADDRESS=Calle Principal 123, Madrid, España
CLINIC_PHONE=+34 912 345 678
CLINIC_EMAIL=info@clinica.com
CLINIC_LOGO_URL=/assets/logo.png

# ============================================
# DATOS DE PRUEBA (solo desarrollo)
# ============================================
CREATE_DEMO_DATA=false  # true solo en desarrollo
