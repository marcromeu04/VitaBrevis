# ============================================
# VitaBrevis - Variables de Entorno
# ============================================
# IMPORTANTE: Copia este archivo a .env y modifica los valores en PRODUCCIÓN

# ============================================
# GENERAL
# ============================================
ENVIRONMENT=development  # development | staging | production
APP_NAME=VitaBrevis
DEBUG=false

# ============================================
# DATABASE
# ============================================
DB_USER=vitabrevis
# IMPORTANTE: Cambiar en producción
DB_PASSWORD=vitabrevis_dev_password_2024
DB_NAME=vitabrevis_db
DB_HOST=db  # 'db' para Docker, 'localhost' para desarrollo local
DB_PORT=5432

# ============================================
# SEGURIDAD - BACKEND
# ============================================
# IMPORTANTE: Generar nuevas claves para producción
# Generar con: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-vitabrevis-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clave de cifrado AES-256
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dev-encryption-key-change-in-production-vitabrevis

# ============================================
# CORS (Frontend URLs permitidas)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=VitaBrevis
VITE_ENABLE_2FA=true

# ============================================
# EMAIL (para notificaciones y 2FA)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@vitabrevis.com
SMTP_FROM_NAME=VitaBrevis

# ============================================
# ALMACENAMIENTO DE ARCHIVOS
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50  # Tamaño máximo de archivos en MB

# ============================================
# GDPR / LOGGING / AUDITORÍA
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
AUDIT_LOG_RETENTION_DAYS=2555  # 7 años (requisito legal)
ENABLE_AUDIT_LOG=true

# ============================================
# RATE LIMITING (protección anti-abuso)
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Cron: cada día a las 2 AM
BACKUP_RETENTION_DAYS=90

# ============================================
# CLÍNICA (Personalización)
# ============================================
CLINIC_NAME=Mi Clínica de Longevidad
CLINIC_ADDRESS=Calle Principal 123, Madrid, España
CLINIC_PHONE=+34 912 345 678
CLINIC_EMAIL=info@clinica.com
CLINIC_LOGO_URL=/assets/logo.png

# ============================================
# DATOS DE PRUEBA (solo desarrollo)
# ============================================
CREATE_DEMO_DATA=false  # true solo en desarrollo
