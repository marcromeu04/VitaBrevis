# Archivos de entorno
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
dist/
dist-ssr/
*.local
.vite/
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs
logs/
*.log
pip-log.txt
pip-delete-this-directory.txt

# Database
*.db
*.sqlite
*.sqlite3
db.sqlite3

# Uploads y datos sensibles
uploads/
backups/
*.csv
*.xlsx
*.pdf
!docs/**/*.pdf

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
coverage/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker
docker-compose.override.yml

# Certificados SSL (NUNCA subir a git)
*.pem
*.key
*.crt
*.cert
ssl/

# Claves de cifrado
encryption_keys/
secrets/

# Datos de pacientes (CRÍTICO - GDPR)
patient_data/
clinical_data/
genetic_data/
health_records/

# Temporal
tmp/
temp/
*.tmp
